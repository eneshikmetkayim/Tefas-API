{
  "name": "tefas-api",
  "version": "1.0.0",
  "description": "TEFAS (Türkiye Elektronik Fon Alım Satım Platformu) API Client",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tefas",
    "fund",
    "investment",
    "finance",
    "turkey",
    "api",
    "yatırım fonu",
    "emeklilik fonu"
  ],
  "author": "TEFAS API Contributors",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/tefas-api"
  }
}
